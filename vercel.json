{
  "version": 2,
  "builds": [
    {
      "src": "missed-call-webhook.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/webhook/missed-call",
      "dest": "missed-call-webhook.js"
    },
    {
      "src": "/health",
      "dest": "missed-call-webhook.js"
    }
  ],
  "env": {
    "KAPSO_API_KEY": "@kapso_api_key",
    "KAPSO_PHONE_NUMBER_ID": "@kapso_phone_number_id",
    "TWILIO_AUTH_TOKEN": "@twilio_auth_token"
  }
}
